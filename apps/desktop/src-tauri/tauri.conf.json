{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SirTone",
  "version": "0.1.35",
  "identifier": "studio.serkov.sirtone",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Сиртон",
        "maximized": true,
        "visible": false,
        "backgroundColor": "#333333",
        "dragDropEnabled": true,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://sirtone-cover.localhost data: blob:; media-src 'self' http://sirtone-bg.localhost blob:; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "devCsp": "default-src 'self'; img-src 'self' http://sirtone-cover.localhost data: blob:; media-src 'self' http://sirtone-bg.localhost blob:; connect-src ipc: http://ipc.localhost ws://localhost:1420; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sir.kov Studio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": { "../../../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt" },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1N0I1NTVGNDI2MDE0RjAKUldUd0ZHQkNYMVY3RlpVeTFtejBYZ04zUFEwcmRDcVBvdUpJZ3d3NzhhWjN0clpiTWlWN1dCU0MK",
      "endpoints": [
        "https://github.com/eropermakov/SirTone/releases/download/update-channel/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
