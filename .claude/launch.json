{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desktop-web",
      "runtimeExecutable": "pnpm.cmd",
      "runtimeArgs": ["--dir", "apps/desktop", "dev", "--host", "127.0.0.1"],
      "port": 1420
    },
    {
      "name": "mobile-viz",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "1431",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/mobile-ios/Sources/SirTone/Resources/viz"
      ],
      "port": 1431
    }
  ]
}
